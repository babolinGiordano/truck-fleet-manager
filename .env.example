# Copia questo file in .env e compila i valori.
# Il .env NON va committato (gia' coperto da .gitignore).
#
#   cp .env.example .env

# --- Database -----------------------------------------------------------
# Password Postgres. Generane una: openssl rand -base64 24
DB_PASSWORD=cambiami-con-una-password-lunga

# Opzionali (hanno un default nel compose, decommenta solo se vuoi cambiarli)
# DB_USERNAME=truck_admin
# DB_NAME=truck_fleet

# --- Dominio pubblico ---------------------------------------------------
# Hostname configurato nel tunnel Cloudflare, SENZA https://
# Usato per CORS_ORIGIN del backend -> https://${APP_DOMAIN}
APP_DOMAIN=demo.esempio.it

# --- Cloudflare Tunnel --------------------------------------------------
# Token del tunnel (Zero Trust > Networks > Tunnels > Create tunnel > Docker).
# Nel dashboard, la Public Hostname del tunnel deve puntare a: http://frontend:80
TUNNEL_TOKEN=eyJhIjoi...incolla-qui-il-token
