{
  "name": "truck-fleet-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Truck Fleet Manager - Monorepo with Angular frontend and NestJS backend",
  "scripts": {
    "dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "pnpm --filter @truck-fleet/frontend start",
    "dev:backend": "pnpm --filter @truck-fleet/backend start:dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @truck-fleet/frontend build",
    "build:backend": "pnpm --filter @truck-fleet/backend build",
    "test": "pnpm -r test",
    "test:frontend": "pnpm --filter @truck-fleet/frontend test",
    "db:generate": "pnpm --filter @truck-fleet/backend prisma generate",
    "db:migrate": "pnpm --filter @truck-fleet/backend prisma migrate dev",
    "db:migrate:prod": "pnpm --filter @truck-fleet/backend prisma migrate deploy",
    "db:studio": "pnpm --filter @truck-fleet/backend prisma studio",
    "db:seed": "pnpm --filter @truck-fleet/backend prisma db seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
