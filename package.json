{
  "name": "truck-fleet-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Truck Fleet Manager - Monorepo with Angular frontend and Spring Boot backend",
  "scripts": {
    "dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "pnpm --filter @truck-fleet/frontend start",
    "dev:backend": "cd apps/backend && mvn spring-boot:run",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:frontend": "pnpm --filter @truck-fleet/frontend build",
    "build:backend": "cd apps/backend && mvn clean package -DskipTests",
    "test": "pnpm test:frontend && pnpm test:backend",
    "test:frontend": "pnpm --filter @truck-fleet/frontend test",
    "test:backend": "cd apps/backend && mvn test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
